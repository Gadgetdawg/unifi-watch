# Copy to config.env on the machine that runs the watcher (the Hermes Mac mini).
# config.env is git-ignored. Never commit real keys.

# UniFi Site Manager API key: https://unifi.ui.com -> (your profile) -> API -> Create API Key
UI_API_KEY=

# Telegram: create a bot with @BotFather (gives the token), message the bot once,
# then run:  python3 unifi_watch.py --find-chat   (prints your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional dead-man switch (https://healthchecks.io). If the watcher stops pinging,
# Healthchecks emails/texts you, so a dead Mac mini can't fail silently.
HEALTHCHECKS_URL=

# Poll every 2 minutes; require 2 bad polls in a row before alerting (~4 min).
POLL_SECONDS=120
CONFIRM_POLLS=2
# Re-alert every 15 minutes while a site stays down.
REPEAT_MINUTES=15

# Site name = primary ISP name (substring match). Anything else counts as failover.
PRIMARY_ISP=Beachfront=MediaCom;Creekside=AT&T;Westcroft=AT&T

# Limit to these sites (comma list). Blank = every console on the account.
WATCH_ONLY=Beachfront,Creekside,Westcroft
